{
  "name": "inanna-seven-gates",
  "version": "0.1.0",
  "private": true,
  "description": "Inanna: Seven Gates - a deadlock-free 2D Mesopotamian puzzle-platformer (TypeScript + Phaser 3, installable PWA)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx tools/validate.ts",
    "bots": "tsx tools/bots.ts",
    "e2e": "playwright test",
    "ci": "npm run typecheck && npm test && npm run validate && npm run build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.11"
  }
}
