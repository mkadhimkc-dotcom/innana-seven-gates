{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://innana-seven-gates/platform-level.schema.json",
  "title": "PlatformLevel",
  "description": "A v2 side-view level (SPEC v2 section 9). Cross-field rules the schema cannot express - the level budget, the guardian period, one gate tile, entities on open tiles - are enforced by parsePlatformLevel.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "gate",
    "name",
    "grid",
    "start",
    "jewels",
    "periodFrames"
  ],
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique level id."
    },
    "gate": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7,
      "description": "Which of the seven gates (SPEC 6)."
    },
    "name": {
      "type": "string"
    },
    "grid": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "description": "Row-major rows of single-character tile codes: '.' empty, '#' solid, 'b' breakable, 'H' ladder, 'G' gate, '^' spikes (SPEC 9).",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "pattern": "^[.#bHG^]+$"
      }
    },
    "start": {
      "$ref": "#/$defs/cell",
      "description": "The player's starting cell."
    },
    "periodFrames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256,
      "description": "The declared level period. Every guardian cycle must divide it (SPEC 16)."
    },
    "jewels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "description": "Every jewel is required; collecting the last opens the gate (SPEC 7).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "$ref": "#/$defs/cell"
          }
        }
      }
    },
    "guardians": {
      "type": "array",
      "maxItems": 4,
      "description": "Deterministic patrols. Position is a pure function of phase (SPEC 16).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "route",
          "stepFrames"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/cell"
            },
            "description": "Cells visited in order, then repeated."
          },
          "stepFrames": {
            "type": "integer",
            "minimum": 1,
            "description": "Frames spent on each cell."
          }
        }
      }
    },
    "axes": {
      "type": "array",
      "description": "Axe pickups. One use breaks a block or kills a guardian (SPEC 15).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "at",
          "uses"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "$ref": "#/$defs/cell"
          },
          "uses": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        }
      }
    }
  }
}
